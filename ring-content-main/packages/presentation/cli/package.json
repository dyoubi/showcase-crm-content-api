{
  "name": "@ringcontent/cli",
  "description": "A new CLI generated with oclif",
  "version": "0.1.0",
  "author": "farod",
  "bin": {
    "cms": "./bin/run.js"
  },
  "bugs": "https://github.com/presentation/cli/issues",
  "dependencies": {
    "@egc-io/ckit-lib": "^1.3.1",
    "@oclif/core": "^4.2.0",
    "@oclif/plugin-help": "^6.2.20",
    "@oclif/plugin-plugins": "^5.4.24",
    "@ringcontent/application": "workspace:^",
    "@ringcontent/core": "workspace:^",
    "@ringcontent/ioc": "workspace:^",
    "@ringcontent/test": "workspace:^",
    "dotenv": "^16.4.7",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.33.5",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@oclif/prettier-config": "^0.2.1",
    "@oclif/test": "^4.1.5",
    "@types/chai": "^5.0.1",
    "@types/dotenv": "^8.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.3",
    "chai": "^5.1.2",
    "eslint": "^9.17.0",
    "eslint-config-oclif": "^5.2.2",
    "eslint-config-oclif-typescript": "^3.1.13",
    "eslint-config-prettier": "^9.1.0",
    "mocha": "^11.0.1",
    "oclif": "^4.17.7",
    "shx": "^0.3.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "/bin",
    "/dist",
    "/oclif.manifest.json"
  ],
  "homepage": "https://github.com/presentation/cli",
  "keywords": [
    "oclif"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "oclif": {
    "bin": "files-cli",
    "dirname": "files-cli",
    "commands": "./dist/commands",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-plugins"
    ],
    "topicSeparator": " ",
    "topics": {},
    "hooks": {
      "init": "./dist/hooks/init/context"
    }
  },
  "repository": "presentation/cli",
  "scripts": {
    "build": "shx rm -rf dist && tsc -b",
    "lint": "eslint . --ext .ts",
    "postpack": "shx rm -f oclif.manifest.json",
    "posttest": "pnpm run lint",
    "prepack": "oclif manifest && oclif readme",
    "test": "mocha --forbid-only \"test/**/*.test.ts\"",
    "version": "oclif readme && git add README.md"
  },
  "types": "dist/index.d.ts"
}